# Remnawave API
RW_API=https://remnawave.example.com/api
RW_TOKEN=

# TLS / public domain for the naive proxy (Caddy issues the cert automatically)
TLS_DOMAIN=node.example.com
TLS_EMAIL=email@example.com
TLS_PORT=443

# Where the generated naive+https links get scp'd to
SSH_HOST=
SSH_USER=user
SSH_PORT=22
SSH_REMOTE_PATH=/example-rw-sub-path/remnawave-subscription-page-huckskee/naive/
SSH_KEY_PATH=./secrets/id_ed25519

# How often the sync loop re-runs, in seconds
SYNC_INTERVAL=300
NODE_NAME=node1